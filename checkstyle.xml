<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Puppy Crawl//DTD Check Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- my plugin config:
Scan scope: All sources (including tests)
Only enable this config file
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="FileLength">
        <!-- changelog doc will continue growing -->
        <property name="fileExtensions" value="java"/>
    </module>
    <module name="FileTabCharacter"/>
    <!-- Java is known as a boilerplate language, and by experience I think a bit more than 120 is good -->
    <module name="LineLength">
        <!-- I personally don't want Markdown format doc to be restricted -->
        <property name="fileExtensions" value="java"/>
        <property name="severity" value="error"/>
        <property name="max" value="160"/>
    </module>
    <!-- No additional level rule for line length, just fix on the final limit -->
    <!--    <module name="LineLength">-->
    <!--        <property name="severity" value="warning"/>-->
    <!--        <property name="max" value="140"/>-->
    <!--    </module>-->
    <!--    <module name="LineLength">-->
    <!--        <property name="severity" value="info"/>-->
    <!--        <property name="max" value="120"/>-->
    <!--    </module>-->
    <module name="NewlineAtEndOfFile"/>
    <module name="UniqueProperties"/>
    <module name="TreeWalker">
        <property name="severity" value="error"/>
        <module name="AbbreviationAsWordInName"/>
        <module name="ArrayTypeStyle"/>
        <module name="AtclauseOrder"/>
        <module name="AvoidDoubleBraceInitialization"/>
        <module name="CommentsIndentation"/>
        <module name="CovariantEquals"/>
        <module name="DefaultComesLast"/>
        <module name="EmptyBlock"/>
        <module name="EmptyCatchBlock">
            <property name="commentFormat" value="^$"/>
            <property name="exceptionVariableName" value="^ignored$"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="FallThrough"/>
        <!-- GuiMixin.java
         @Inject(method = "setTitle", at = @At("TAIL"))
    public void setTitleMixin(Component title, CallbackInfo ci) {
        MainClass.speakWithNarrator(title.getString(), true);        <======= Here
        if (subtitle != null) MainClass.speakWithNarrator(subtitle.getString(), false);
    }
     "title.getString()" triggers this rule, and this rule doesn't provide a property for suppressing non-first-party package
     ref: https://checkstyle.sourceforge.io/checks/coding/hiddenfield.html
         -->
        <!--        <module name="HiddenField">-->
        <!--            <property name="ignoreConstructorParameter" value="true"/>-->
        <!--            <property name="ignoreSetter" value="true"/>-->
        <!--        </module>-->
        <module name="IllegalCatch"/>
        <module name="IllegalIdentifierName"/>
        <module name="IllegalType"/>
        <!-- My IDEA's setting, "Code Style-Java-Continuation Indent" value is 8,
         which against this rule, set to 4 resolves the warning.
        The default value of IDEA is 8.
          -->
        <module name="Indentation"/>
        <module name="InvalidJavadocPosition"/>
        <module name="JavadocBlockTagLocation"/>
        <module name="JavadocContentLocation"/>
        <module name="JavadocLeadingAsteriskAlign"/>
        <module name="JavadocMissingLeadingAsterisk"/>
        <module name="JavadocMissingWhitespaceAfterAsterisk"/>
        <module name="JavadocTagContinuationIndentation"/>
        <module name="JavadocType"/>
        <module name="MissingOverride"/>
        <module name="ModifiedControlVariable"/>
        <module name="ModifierOrder"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="MutableException"/>
        <module name="NoCodeInFile"/>
        <module name="NonEmptyAtclauseDescription"/>
        <module name="OneStatementPerLine"/>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="OuterTypeNumber"/>
        <module name="PackageAnnotation"/>
        <module name="PackageDeclaration"/>
        <module name="ParameterAssignment"/>
        <module name="RedundantImport"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="SuppressWarnings"/>
        <module name="TodoComment">
            <property name="format" value="(?i)^ *(TODO|FIXME)"/>
        </module>
        <module name="TypeName"/>
        <module name="UncommentedMain"/>
        <module name="UnnecessaryParentheses">
            <property name="tokens"
                      value="EXPR, IDENT, NUM_DOUBLE, NUM_FLOAT, NUM_INT, NUM_LONG, STRING_LITERAL, LITERAL_NULL, LITERAL_FALSE, LITERAL_TRUE, ASSIGN, BAND_ASSIGN, BOR_ASSIGN, BSR_ASSIGN, BXOR_ASSIGN, DIV_ASSIGN, MINUS_ASSIGN, MOD_ASSIGN, PLUS_ASSIGN, SL_ASSIGN, SR_ASSIGN, STAR_ASSIGN, TEXT_BLOCK_LITERAL_BEGIN, LAND, LOR, LITERAL_INSTANCEOF, GT, LT, GE, LE, EQUAL, NOT_EQUAL, UNARY_MINUS, UNARY_PLUS, INC, DEC, LNOT, BNOT, POST_INC, POST_DEC"/>
        </module>
        <module name="UnnecessarySemicolonAfterOuterTypeDeclaration"/>
        <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>
        <module name="UnusedImports"/>
        <module name="UnusedLocalVariable"/>
        <module name="UpperEll"/>
        <module name="WhenShouldBeUsed"/>
    </module>
    <module name="TreeWalker">
        <property name="severity" value="warning"/>
        <module name="AnnotationUseStyle"/>
        <module name="AnonInnerLength"/>
        <module name="ArrayTrailingComma"/>
        <module name="AvoidNestedBlocks"/>
        <module name="AvoidNoArgumentSuperConstructorCall"/>
        <module name="BooleanExpressionComplexity"/>
        <module name="CatchParameterName"/>
        <module name="ClassTypeParameterName"/>
        <module name="ConstantName"/>
        <module name="ConstructorsDeclarationGrouping"/>
        <module name="DeclarationOrder">
            <property name="ignoreModifiers" value="true"/>
        </module>
        <module name="EmptyForInitializerPad"/>
        <module name="EmptyForIteratorPad"/>
        <module name="EmptyLineSeparator">
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
        </module>
        <module name="ExecutableStatementCount"/>
        <module name="FinalClass"/>
        <module name="GenericWhitespace"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="IllegalThrows"/>
        <!--
         import java.util.Arrays;
         import java.util.List;
         this will trigger the rule, well, this is alphabetically ordered by IDEA
         ref: https://checkstyle.sourceforge.io/checks/imports/importorder.html
         -->
        <!--        <module name="ImportOrder"/>-->
        <module name="InnerAssignment"/>
        <!--
        The corresponding IDEA settings is ... "Code Style-Java-Arrangement",
        The default rule set doesn't emphasize this rule,
        but it's possible to make it auto-formatted via adding new rules.
        My personal coding style is first writing spaghetti code and extract private methods with hotkey,
        so my personal habit can't guarantee this rule.
         -->
        <module name="InnerTypeLast"/>
        <module name="InterfaceIsType"/>
        <module name="InterfaceTypeParameterName"/>
        <module name="JavaNCSS"/>
        <module name="LambdaBodyLength"/>
        <module name="LambdaParameterName"/>
        <module name="LeftCurly">
            <property name="ignoreEnums" value="false"/>
        </module>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <!-- there are @Unique class field like "mca$foo" against this rule -->
        <!--        <module name="MemberName"/>-->
        <module name="MethodCount"/>
        <module name="MethodName"/>
        <module name="MethodParamPad"/>
        <module name="MethodTypeParameterName"/>
        <module name="NestedIfDepth"/>
        <module name="NestedTryDepth"/>
        <module name="NoLineWrap"/>
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="NoWhitespaceBeforeCaseDefaultColon"/>
        <module name="OperatorWrap"/>
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="ParameterNumber"/>
        <module name="ParenPad"/>
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="RecordComponentNumber"/>
        <module name="RedundantModifier"/>
        <module name="RequireEmptyLineBeforeBlockTagGroup"/>
        <module name="RightCurly"/>
        <module name="SealedShouldHavePermitsList"/>
        <!--
        Haven't found corresponding IDEA Code Style settings
        I've seen you (TSG) modified "+" position when concatenating Strings, to make the "+" at previous lines
        Unfortunately my stream API and mul String concatenating habit against this rule.
        My opinion is, We'd better not add formatting rules that can't be auto-fixed by IDE.
         -->
        <module name="SeparatorWrap"/>
        <module name="SingleLineJavadoc">
            <property name="ignoreInlineTags" value="false"/>
        </module>
        <module name="SingleSpaceSeparator"/>
        <module name="StaticVariableName"/>
        <module name="SummaryJavadoc"/>
        <module name="TypecastParenPad"/>
        <module name="UnnecessarySemicolonInEnumeration"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
    </module>
    <module name="TreeWalker">
        <property name="severity" value="info"/>
        <!--
         /**
         ....
     */
    @Inject(method = "renderLabels", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/GuiGraphics;fill(IIIII)V"))
    protected void speakCost(GuiGraphics context, int mouseX, int mouseY, CallbackInfo ci, @Local Component text) {

        Method above triggers this, but I really don't want to write doc for every method param,
        not because this example is mixin method, but good param names should self-explained

        ref: https://checkstyle.org/checks/javadoc/javadocmethod.html#JavadocMethod
         -->
        <module name="JavadocMethod">
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
            <!--
            the above two, or below one, better above two according to my opinion above
            or just delete this rule
             -->
            <property name="allowedAnnotations" value="Inject,and other mixin annotations for method"/>
        </module>
        <module name="JavadocParagraph"/>
        <module name="JavadocStyle"/>
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
        </module>
        <module name="VariableDeclarationUsageDistance"/>
    </module>
</module>
