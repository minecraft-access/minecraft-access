<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <suppress files="\.(?:png|mp3|ogg|jar)$" checks=".*"/>
    <suppress files="/\.git/" checks=".*"/>
    <suppress files="/gradlew(?:\.bat)?$" checks=".*"/>
    <suppress files="/common/src/main/resources/assets/minecraft_access/lang/.+\.json$" checks="^LineLength$"/>
    <suppress files="/docs/themes/" checks=".*"/>
</suppressions>
